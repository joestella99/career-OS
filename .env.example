# Configure only in your local .env.local or Vercel encrypted project settings.
# Do not commit credentials, and do not paste keys into ChatGPT.
# Optional on Vercel deployments when Gateway OIDC authentication is enabled.
AI_GATEWAY_API_KEY=
CAREEROS_ACCESS_KEY=
# Optional, defaults to openai/gpt-6-sol-fast
CAREEROS_ASSISTANT_MODEL=openai/gpt-6-sol-fast

# Fresh Jobs: optional SearchAPI paid provider (server-side only).
# No LinkedIn password or cookies. Sign up for a trial directly with the provider.
SEARCHAPI_API_KEY=
