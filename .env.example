# CareerOS is free-by-default.
# Public Ashby company job feeds need NO API key.
# AI Copilot remains disabled, so no metered requests are made.

CAREEROS_ENABLE_METERED_AI=false

# Only for a future EXPLICIT opt-in to separately billed AI:
# CAREEROS_ACCESS_KEY=
# AI_GATEWAY_API_KEY=
# CAREEROS_ASSISTANT_MODEL=
