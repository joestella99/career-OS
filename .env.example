# CareerOS runs at no additional API cost.
# Public company job boards require no credentials.
CAREEROS_ENABLE_METERED_AI=false

# OPTIONAL: Import LinkedIn and Built In email job alerts in-browser, without paid APIs.
# This is the non-secret OAuth client ID from your free Google Cloud web application.
# Configure "Authorized JavaScript origins" for your Vercel domain and localhost.
# Enable the Gmail API; with Google OAuth configured you will connect Gmail in CareerOS.
# Gmail's readonly scope requires explicit user consent and may require verification.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ONLY IF you intentionally enable separately billed AI in a future update:
# CAREEROS_ACCESS_KEY=
# AI_GATEWAY_API_KEY=
# CAREEROS_ASSISTANT_MODEL=
